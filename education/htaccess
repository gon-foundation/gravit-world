# gravit.world moved to gravitopennetwork.org on 22 Oct 2026. Every path keeps working.
# Since 9 Nov 2026 gravit.world also serves Gravit Education: /manifest/ and /lessons/ (source: education/ in this repository).
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/(manifest|lessons)(/|$)
RewriteRule ^(.*)$ https://gravitopennetwork.org/$1 [R=301,L]
